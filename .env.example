# Ganti kedua password ini dengan nilai kuat dan berbeda sebelum deploy.
APP_PORT=8081
# Default is a folder beside this repository. Change to e.g. D:/MomaBread/Uploads to relocate it.
UPLOADS_PATH=./Uploads
DB_NAME=moma_bread
DB_USER=moma_app
DB_PASSWORD=replace-with-a-long-random-password
DB_ROOT_PASSWORD=replace-with-another-long-random-password
